<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The MAUI half of Freedom: working defaults for every seam Freedom.Client
    leaves open, so an Android app needs nothing but options and a callback
    activity.

    Two builds. net10.0-android has everything, the ANDROID_ID device identity
    and Android's own HTTP stack included. net10.0 serves every other head —
    iOS, Mac Catalyst, Windows — because MAUI's own packages ship a plain
    net10.0 build beside the platform ones and an app resolves the right one
    per head. There it has the SecureStorage stores, WebAuthenticator and
    UseFreedom, but no device identity: what an iOS or Windows device should
    be identified by is still open (see "What is not done"). That is enough
    for a session handover, which is how Link signs in, and not for a
    browser sign-in, which says so rather than failing obscurely.
  -->

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>

    <PackageId>Freedom.Client.Maui</PackageId>
    <Version>0.1.1</Version>
    <Authors>The Bleeding Deacons</Authors>
    <Company>The Bleeding Deacons</Company>
    <Product>Freedom Client for .NET MAUI</Product>
    <Description>MAUI defaults for Freedom.Client: WebAuthenticator sign-in, ANDROID_ID device identity, SecureStorage for credentials and configuration, and builder.UseFreedom().</Description>
    <PackageTags>maui;android;configuration;secrets;freedom</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/bleedingdeacons/freedom-sharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/bleedingdeacons/freedom-sharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Copyright>Don't take yourself too damn seriously</Copyright>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Android's own code, only in Android's build. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android'">
    <Compile Remove="Platforms\Android\**" />
    <None Include="Platforms\Android\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheBleedingDeacons.Freedom.Client\TheBleedingDeacons.Freedom.Client.csproj" />
    <ProjectReference Include="..\TheBleedingDeacons.Freedom.Models\TheBleedingDeacons.Freedom.Models.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
